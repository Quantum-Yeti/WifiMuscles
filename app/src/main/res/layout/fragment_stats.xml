<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_primary"
    android:fitsSystemWindows="true"
    tools:context=".view.fragments.StatsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:background="@color/bg_app_primary">

        <!-- Title Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/bg_app_primary"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/titleIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/icon_menu_bold"
                android:contentDescription="@string/menu_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/infoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/card_background_one"
            app:cardCornerRadius="16dp"
            app:cardElevation="0.5dp"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/titleSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp"
                    tools:ignore="UseCompoundDrawables">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/connection_info"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/whiteText"
                        android:gravity="start" />

                    <ImageView
                        android:id="@+id/rssiEmoji"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/emoji_happy" />
                </LinearLayout>

                <!-- Subheader Section -->
                <TextView
                    android:id="@+id/subheaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description_subheader"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:textColor="@color/text_secondary"

                    android:gravity="start" />


                <!-- Wi-Fi Signal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/wifiTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/wi_fi_signal"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_light_blue" />
                    <ImageView
                        android:id="@+id/wifiIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/icon_wifi"
                        app:tint="@color/accent_secondary" />
                </LinearLayout>

                <TextView android:id="@+id/levelBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/capabilityBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/channelBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/centerBox0"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/centerBox1"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/passpointBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/responderBox"
                    style="@style/StatsTextView" />

                <!-- Speed Test/Throughput -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_test_throughput"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_light_blue" />
                    <ImageView
                        android:id="@+id/speedIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/icon_rocket"
                        app:tint="@color/accent_orange" />
                </LinearLayout>

                <TextView android:id="@+id/downstreamBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/upstreamBox"
                    style="@style/StatsTextView" />

                <!-- Network Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    tools:ignore="UseCompoundDrawables">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/network_info"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_light_blue" />
                    <ImageView
                        android:id="@+id/networkIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/icon_ip_globe"
                        app:tint="@color/accent_secondary" />
                </LinearLayout>

                <TextView android:id="@+id/gatewayBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/netmaskBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/dns1Box"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/dns2Box"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/leaseDurationBox"
                    style="@style/StatsTextView" />

                <!-- Connectivity Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/connectivity_status"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_light_blue" />
                    <ImageView
                        android:id="@+id/connectivityIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/icon_host"
                        app:tint="@color/red" />
                </LinearLayout>

                <TextView android:id="@+id/transportBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/isInternetBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/validateBox"
                    style="@style/StatsTextView" />
                <TextView android:id="@+id/meteredBox"
                    style="@style/StatsTextView" />


            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
